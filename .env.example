# ---------------------------------------------------------------------------
# SENTRA environment configuration (placeholders only - never commit real .env)
# Copy this file to `.env` in the project root:  cp .env.example .env
# ---------------------------------------------------------------------------

# Port the Express API listens on.
PORT=4000

# Comma/space-separated list of the exact browser origins allowed to call the
# API (CORS + CSRF origin check share this list). Local dev default:
FRONTEND_ORIGIN=http://localhost:5173
# Hosted previews (Arena/E2B): every listening port is served at
# https://<port>-<sandboxId>.e2b.app. When the platform exports E2B_SANDBOX_ID
# those exact origins are derived automatically - no wildcard. Set PREVIEW_HOSTS
# for other platforms, or list full origins in FRONTEND_ORIGIN instead.
# PREVIEW_PORTS=5173,4000
# PREVIEW_HOSTS=my-preview.example.com
# Opt-in glob patterns for origins that change per session (empty by default;
# keep it as tight as possible, e.g. only the ports this app serves):
# FRONTEND_ORIGIN_PATTERNS=https://5173-*.e2b.app,https://4000-*.e2b.app

# Cookie SameSite policy: lax (default) | strict | none.
# "none" is for genuine cross-site setups and forces COOKIE_SECURE on, because
# browsers reject SameSite=None without Secure.
COOKIE_SAMESITE=lax

# REQUIRED in production. Signs session cookies / IDs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# development | production  (production turns on Secure cookies and strict errors)
NODE_ENV=development

# SQLite database file. Relative paths resolve against the server/ directory.
DATABASE_PATH=server/data/sentra.db

# Public Overpass API endpoint used for nearby OpenStreetMap features.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------------
# Upstream Overpass request timeout in milliseconds (the query timeout sent to
# Overpass is derived from this, keeping it under the frontend's request timeout)
OVERPASS_TIMEOUT_MS=25000
# Descriptive User-Agent sent to Overpass (their usage policy asks for one)
OVERPASS_USER_AGENT=SENTRA/1.0 (mood-aware travel discovery; contact: you@example.com)
# Nearby-search cache TTL in milliseconds
PLACES_CACHE_TTL_MS=300000
# Seconds before an idle session expires
SESSION_TTL_SECONDS=604800
# Force cookie flags when running behind a TLS-terminating proxy
COOKIE_SECURE=false
# Trust X-Forwarded-* headers from a reverse proxy (1 = enable)
TRUST_PROXY=0
# Clickjacking policy for the HTML shell only (the JSON API always sends
# frame-ancestors 'none'). Production default is 'self'.
# Example: FRAME_ANCESTORS='self' https://*.example.com
FRAME_ANCESTORS=
